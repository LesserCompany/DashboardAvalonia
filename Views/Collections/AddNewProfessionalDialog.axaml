<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LesserDashboardClient.ViewModels.Collections"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia.ProgressRing"
        x:DataType="vm:CollectionsViewModel"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="620"
        x:Class="LesserDashboardClient.Views.Collections.AddNewProfessionalDialog"
        Title="{Tr 'Add new professional'}"
        Width="660"
        Height="660"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Window.Styles>
    <Style Selector="Border.header-card">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Border.section-card">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="TextBlock.helper">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource MetaFg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style Selector="TextBox.form-input">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource CardBgHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.form-input:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.primary-action">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinWidth" Value="170"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary-action:pointerover">
      <Setter Property="Background" Value="#FFB43A"/>
    </Style>

    <Style Selector="Button.secondary-action">
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.secondary-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardBgHover}"/>
    </Style>
  </Window.Styles>

  <Grid Margin="18" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="header-card" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Border Width="44"
                Height="44"
                CornerRadius="22"
                Background="#1FFF9600"
                BorderBrush="#55FF9600"
                BorderThickness="1"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
          <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14M17,10V12H19V14H17V16H15V14H13V12H15V10H17Z"
                Fill="{DynamicResource Accent}"
                Width="22"
                Height="22"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Tr 'Add new professional'}"
                     FontSize="24"
                     FontWeight="Bold"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Tr 'Fill in the information to create a new professional'}"
                     Foreground="{DynamicResource MetaFg}"
                     FontSize="14"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Classes="section-card">
          <StackPanel>
            <TextBlock Text="{Tr 'Display name'}" Classes="label"/>
            <TextBox Classes="form-input"
                     Text="{Binding TbNewProfessionalSurname}"
                     Watermark="{Tr 'Friendly name shown in the app'}"
                     IsEnabled="{Binding !CreateProfessionalIsRunning}"/>
            <TextBlock Classes="helper" Text="{Tr 'Display name help'}"/>
          </StackPanel>
        </Border>

        <Border Classes="section-card">
          <StackPanel>
            <TextBlock Text="{Tr 'Username (login)'}" Classes="label"/>
            <TextBox Classes="form-input"
                     Text="{Binding TbNewProfessionalUsername}"
                     Watermark="{Tr 'Minimum 4 characters'}"
                     IsEnabled="{Binding !CreateProfessionalIsRunning}"/>
            <TextBlock Classes="helper" Text="{Tr 'Username login help'}"/>
          </StackPanel>
        </Border>

        <Border Classes="section-card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel>
                <TextBlock Text="{Tr 'Email'} *" Classes="label"/>
                <TextBox Classes="form-input"
                         Text="{Binding TbNewProfessionalEmail}"
                         Watermark="email@exemplo.com"
                         IsEnabled="{Binding !CreateProfessionalIsRunning}"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Tr 'Confirm Email'}" Classes="label"/>
                <TextBox Classes="form-input"
                         Text="{Binding TbNewProfessionalConfirmEmail}"
                         Watermark="{Tr 'Confirm the email'}"
                         IsEnabled="{Binding !CreateProfessionalIsRunning}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding CreateProfessionalErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#26F44336"
                BorderBrush="#88F44336"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"
                  Fill="#FF6E6E"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"/>
            <TextBlock Text="{Binding CreateProfessionalErrorMessage}"
                       Foreground="#FFD6D6"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding CreateProfessionalSuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#224CAF50"
                BorderBrush="#884CAF50"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                  Fill="#7DDA83"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"/>
            <TextBlock Text="{Binding CreateProfessionalSuccessMessage}"
                       Foreground="#CEF2D2"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10"
            Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ui:ProgressRing Width="16"
                           Height="16"
                           BorderThickness="2"
                           IsIndeterminate="True"
                           IsVisible="{Binding CreateProfessionalIsRunning}"/>
          <TextBlock Text="{Tr 'Creating professional...'}"
                     IsVisible="{Binding CreateProfessionalIsRunning}"
                     Foreground="{DynamicResource MetaFg}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1"
                Classes="secondary-action"
                Content="{Tr 'Cancel'}"
                Command="{Binding CancelAddNewProfessionalCommand}"
                IsEnabled="{Binding !CreateProfessionalIsRunning}"/>
        <Button Grid.Column="2"
                Classes="primary-action"
                Command="{Binding CreateNewProfessionalCommand}"
                IsEnabled="{Binding !CreateProfessionalIsRunning}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:ProgressRing Width="14"
                             Height="14"
                             BorderThickness="2"
                             IsIndeterminate="True"
                             IsVisible="{Binding CreateProfessionalIsRunning}"/>
            <TextBlock Text="{Tr 'Create Professional'}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>







