<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LesserDashboardClient.ViewModels.Collections"
             xmlns:local="clr-namespace:LesserDashboardClient.Views.Collections"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia.ProgressRing"
             x:DataType="vm:CollectionsViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="750"
             x:Class="LesserDashboardClient.Views.Collections.CollectionPartialAutoTreatment">
  <!-- Pedido de lote de tratamento parcial: escolhe pastas e/ou formandos, o servidor calcula o lote
       (sem as já tratadas / já pedidas) e a confirmação manda as fotos pra fila — sem volta. -->
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <!-- Voltar + título -->
      <Grid ColumnDefinitions="Auto, *, Auto">
        <Button Grid.Column="0" Command="{Binding BackLasViewCommand}" VerticalAlignment="Center"
                Padding="8,4" Background="Transparent" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="←" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Tr 'Back'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
          <TextBlock Text="{Tr 'Partial treatment'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <SelectableTextBlock Text="{Binding SelectedCollection.classCode}" FontSize="13" Foreground="{DynamicResource MetaFg}" HorizontalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2" Command="{Binding RefreshPartialAutoTreatmentCommand}" VerticalAlignment="Center"
                Padding="10,6" ToolTip.Tip="{Tr 'Refresh'}">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" />
        </Button>
      </Grid>

      <!-- Progresso -->
      <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
              CornerRadius="10" Padding="14,12">
        <local:PartialAutoTreatmentProgress />
      </Border>

      <!-- Não elegível -->
      <Border IsVisible="{Binding PartialNotEligibleReason, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="#1F808080" BorderBrush="#80808080" BorderThickness="1" CornerRadius="8" Padding="12,10">
        <TextBlock Text="{Binding PartialNotEligibleReason}" TextWrapping="Wrap" />
      </Border>

      <StackPanel IsVisible="{Binding PartialIsEligible}" Spacing="12">
        <!-- Aviso: sem volta -->
        <Border Background="#1FF59E0B" BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,10">
          <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
            <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="16" Foreground="#FFF59E0B" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                       Text="{Tr 'Choose folders and/or participants. Photos already treated or already in a batch are left out automatically. Once requested, the batch goes to the treatment queue and cannot be cancelled.'}" />
          </Grid>
        </Border>

        <!-- Seleção -->
        <TabControl>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Tr 'By folder'}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BadgeBg}" CornerRadius="8" Padding="6,0" IsVisible="{Binding PartialHasSelectedFolders}">
                  <TextBlock Text="{Binding PartialSelectedFoldersCount}" FontSize="11" Foreground="{DynamicResource BadgeFg}" />
                </Border>
              </StackPanel>
            </TabItem.Header>
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
              <StackPanel>
                <Grid ColumnDefinitions="40, *, 90, 90, 90, 110" ColumnSpacing="8" Margin="12,8">
                  <TextBlock Grid.Column="1" Text="{Tr 'Folder'}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Tr 'Photos'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Tr 'Treated'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Tr 'In the queue'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="{Tr 'Available'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding PartialFolders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PartialFolderRow">
                      <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                        <Grid ColumnDefinitions="40, *, 90, 90, 90, 110" ColumnSpacing="8">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                          <TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="3" Text="{Binding TreatedText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF22C55E" />
                          <TextBlock Grid.Column="4" Text="{Binding PendingText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFF59E0B" />
                          <TextBlock Grid.Column="5" Text="{Binding AvailableText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Tr 'By participant'}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BadgeBg}" CornerRadius="8" Padding="6,0" IsVisible="{Binding PartialHasSelectedParticipants}">
                  <TextBlock Text="{Binding PartialSelectedParticipantsCount}" FontSize="11" Foreground="{DynamicResource BadgeFg}" />
                </Border>
              </StackPanel>
            </TabItem.Header>
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBox Text="{Binding PartialParticipantSearch}" Watermark="{Tr 'Search by name or CPF'}" />
              <StackPanel IsVisible="{Binding PartialParticipantsLoading}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" BorderThickness="3" Width="16" Height="16" />
                <TextBlock Text="{Tr 'Loading participants...'}" />
              </StackPanel>
              <TextBlock IsVisible="{Binding PartialParticipantsError, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Text="{Binding PartialParticipantsError}" Foreground="#FFFF6B6B" TextWrapping="Wrap" />
              <!-- A lista inteira de formandos da coleção aparece aqui embaixo; a busca acima só filtra. -->
              <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6" IsVisible="{Binding PartialParticipantsHasRows}">
                <TextBlock Grid.Column="0" Text="{Binding PartialParticipantsCountText}" FontSize="12" Foreground="{DynamicResource MetaFg}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding SelectAllVisiblePartialParticipantsCommand}" Padding="10,4" FontSize="12">
                  <TextBlock Text="{Tr 'Select all listed'}" />
                </Button>
                <Button Grid.Column="2" Command="{Binding UnselectAllVisiblePartialParticipantsCommand}" Padding="10,4" FontSize="12">
                  <TextBlock Text="{Tr 'Unselect listed'}" />
                </Button>
              </Grid>
              <TextBlock IsVisible="{Binding PartialParticipantsEmpty}" Text="{Tr 'No participants registered in this collection.'}"
                         Foreground="{DynamicResource MetaFg}" HorizontalAlignment="Center" />
              <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" MaxHeight="360" IsVisible="{Binding PartialParticipantsHasRows}">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding PartialParticipantsFiltered}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PartialParticipantRow">
                        <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                          <Grid ColumnDefinitions="40, *, 140" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding CpfMasked}" VerticalAlignment="Center" Foreground="{DynamicResource MetaFg}" HorizontalAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </TabItem>
        </TabControl>

        <!-- Resumo do lote (simulação) -->
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14,12" IsVisible="{Binding PartialHasSelection}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Tr 'Batch summary'}" FontWeight="SemiBold" FontSize="15" />
              <ui:ProgressRing IsVisible="{Binding PartialSimulating}" IsIndeterminate="True" BorderThickness="3" Width="14" Height="14" />
            </StackPanel>
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="4" IsVisible="{Binding PartialHasSimulation}">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Tr 'Selected photos'}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PartialSimulationSelectedText}" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Tr 'Already treated (left out)'}" Foreground="#FF22C55E" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartialSimulationTreatedText}" HorizontalAlignment="Right" Foreground="#FF22C55E" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{Tr 'Already in a batch (left out)'}" Foreground="#FFF59E0B" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PartialSimulationRequestedText}" HorizontalAlignment="Right" Foreground="#FFF59E0B" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{Tr 'Photos in this batch'}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PartialSimulationBillableText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{Tr 'Amount'}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PartialSimulationValueText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
            </Grid>
            <!-- Detalhamento: a qual pasta/formando o lote se destina, com as contas de cada um. -->
            <StackPanel Spacing="4" IsVisible="{Binding PartialHasSimulation}">
              <TextBlock Text="{Tr 'Per folder / participant'}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
              <ItemsControl ItemsSource="{Binding PartialSimulationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PartialSelectionItemRow">
                    <Grid ColumnDefinitions="22, *" Margin="0,2">
                      <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{DynamicResource MetaFg}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Tr 'A photo that is both in a chosen folder and of a chosen participant appears in both lines, but enters the batch only once.'}"
                         FontSize="11" Foreground="{DynamicResource MetaFg}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock IsVisible="{Binding PartialSimulationFreeTrial}" FontSize="11" Foreground="{DynamicResource MetaFg}" TextWrapping="Wrap"
                       Text="{Tr 'Requested during the free trial: the free trial discount is applied on the invoice.'}" />
            <TextBlock IsVisible="{Binding PartialSimulationCpfsNotFoundText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding PartialSimulationCpfsNotFoundText}" FontSize="11" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding PartialMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding PartialMessage}" Foreground="#FFFF6B6B" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" Margin="0,4,0,0">
              <Button Grid.Column="0" Command="{Binding ClearPartialSelectionCommand}" Padding="12,8">
                <TextBlock Text="{Tr 'Clear selection'}" />
              </Button>
              <Button Grid.Column="1" Command="{Binding RequestPartialAutoTreatmentCommand}" IsEnabled="{Binding PartialCanRequest}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"
                      Background="{DynamicResource SystemControlBackgroundAccentBrush}" Foreground="White" BorderThickness="0">
                <Panel>
                  <TextBlock Text="{Tr 'Request treatment'}" IsVisible="{Binding !PartialRequesting}" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PartialRequesting}">
                    <ui:ProgressRing IsIndeterminate="True" BorderThickness="3" Width="14" Height="14" />
                    <TextBlock Text="{Tr 'Sending to the queue...'}" />
                  </StackPanel>
                </Panel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Lotes já pedidos -->
      <StackPanel IsVisible="{Binding PartialHasBatches}" Spacing="6">
        <TextBlock Text="{Tr 'Requested batches'}" FontWeight="SemiBold" FontSize="15" />
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <Grid ColumnDefinitions="125, *, 140, 80, 80, 110" ColumnSpacing="8" Margin="12,8">
              <TextBlock Grid.Column="0" Text="{Tr 'Date'}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Tr 'Selection'}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Grid.Column="2" Text="{Tr 'Requested by'}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Grid.Column="3" Text="{Tr 'Photos'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Text="{Tr 'Left out'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="5" Text="{Tr 'Amount'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding PartialBatches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PartialBatchRow">
                  <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                    <Grid ColumnDefinitions="125, *, 140, 80, 80, 110" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding DateText}" VerticalAlignment="Center" FontSize="12" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding SelectionText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectionText}"
                                   IsVisible="{Binding !HasItems}" />
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PartialSelectionItemRow">
                              <Grid ColumnDefinitions="18, *">
                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="11" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="{DynamicResource MetaFg}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock IsVisible="{Binding EnqueueFailed}" Text="{Tr 'Failed to queue - will be reprocessed'}" FontSize="11" Foreground="#FFFF6B6B" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding RequestedByText}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding BillableText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                      <TextBlock Grid.Column="4" Text="{Binding SkippedText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MetaFg}" />
                      <TextBlock Grid.Column="5" Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
