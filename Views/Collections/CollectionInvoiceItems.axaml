<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LesserDashboardClient.ViewModels.Collections"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia.ProgressRing"
             x:DataType="vm:CollectionsViewModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LesserDashboardClient.Views.Collections.CollectionInvoiceItems">
  <!-- Itens de cobrança da coleção selecionada: uma linha por item, do mais recente pro mais antigo.
       Larguras das colunas fixas e repetidas no cabeçalho e nas linhas (mesmos valores). -->
  <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="16">
    <!-- Voltar + título -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
      <Button Grid.Column="0"
              Command="{Binding BackLasViewCommand}"
              VerticalAlignment="Center"
              Padding="8,4"
              Background="Transparent"
              BorderThickness="0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="←" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="{Tr 'Back'}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
        <TextBlock Text="{Tr 'Billing items'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <SelectableTextBlock Text="{Binding SelectedCollection.classCode}" FontSize="13" Foreground="{DynamicResource MetaFg}" HorizontalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="2"
              Command="{Binding RefreshCollectionInvoiceItemsCommand}"
              IsEnabled="{Binding !CollectionInvoiceItemsIsLoading}"
              VerticalAlignment="Center"
              Padding="10,6"
              ToolTip.Tip="{Tr 'Refresh'}">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" />
      </Button>
    </Grid>

    <!-- Aviso das prévias -->
    <Border Grid.Row="1"
            IsVisible="{Binding CollectionInvoiceItemsHasPreview}"
            Background="#1FF59E0B"
            BorderBrush="#80F59E0B"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="16" Foreground="#FFF59E0B" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   TextWrapping="Wrap"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Text="{Tr 'Items marked as Preview may still change until the monthly billing cycle closes. Consolidated items are already part of a closed invoice.'}" />
      </Grid>
    </Border>

    <!-- Cabeçalho da tabela -->
    <Border Grid.Row="2"
            IsVisible="{Binding CollectionInvoiceItemsHasRows}"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="8,8,0,0"
            Padding="12,8">
      <Grid ColumnDefinitions="90, 2*, 3*, 90, 120, 130" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="{Tr 'Period'}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Tr 'Type'}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Grid.Column="2" Text="{Tr 'Description'}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Grid.Column="3" Text="{Tr 'Photos'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="4" Text="{Tr 'Amount'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5" Text="{Tr 'Status'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Linhas / carregando / vazio / erro -->
    <Panel Grid.Row="3">
      <ScrollViewer IsVisible="{Binding CollectionInvoiceItemsHasRows}">
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
          <ItemsControl ItemsSource="{Binding CollectionInvoiceItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CollectionInvoiceItemRow">
                <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                  <Grid ColumnDefinitions="90, 2*, 3*, 90, 120, 130" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding PeriodText}" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding TypeText}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding DescriptionText}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MetaFg}" ToolTip.Tip="{Binding DescriptionText}" />
                    <TextBlock Grid.Column="3" Text="{Binding PhotosText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" />
                    <TextBlock Grid.Column="4" Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                               TextDecorations="{Binding IsCancelled, Converter={StaticResource BoolToTextDecorationConverter}}" />
                    <Panel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusTooltip}">
                      <Border IsVisible="{Binding IsConsolidated}" Background="#2216A34A" BorderBrush="#8016A34A" BorderThickness="1" CornerRadius="10" Padding="10,2">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF22C55E" />
                      </Border>
                      <Border IsVisible="{Binding IsPreviewAndNotCancelled}" Background="#22F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="10" Padding="10,2">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#FFF59E0B" />
                      </Border>
                      <Border IsVisible="{Binding IsCancelled}" Background="#22808080" BorderBrush="#80808080" BorderThickness="1" CornerRadius="10" Padding="10,2">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MetaFg}" />
                      </Border>
                    </Panel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </ScrollViewer>

      <StackPanel IsVisible="{Binding CollectionInvoiceItemsIsLoading}" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:ProgressRing IsIndeterminate="True" BorderThickness="4" Width="28" Height="28" />
        <TextBlock Text="{Tr 'Loading billing items...'}" HorizontalAlignment="Center" />
      </StackPanel>

      <TextBlock IsVisible="{Binding CollectionInvoiceItemsIsEmpty}"
                 Text="{Tr 'This collection has no billing items yet.'}"
                 Foreground="{DynamicResource MetaFg}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

      <TextBlock IsVisible="{Binding CollectionInvoiceItemsError, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Text="{Binding CollectionInvoiceItemsError}"
                 Foreground="#FFFF6B6B"
                 TextWrapping="Wrap"
                 MaxWidth="480"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Panel>

    <!-- Totais -->
    <StackPanel Grid.Row="4" IsVisible="{Binding CollectionInvoiceItemsHasRows}" Spacing="4" Margin="0,10,0,0">
      <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Tr 'Total consolidated (excluding canceled items)'}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="1" Text="{Binding CollectionInvoiceItemsConsolidatedTotalText}" FontWeight="SemiBold" MinWidth="110" TextAlignment="Right" />
      </Grid>
      <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" IsVisible="{Binding CollectionInvoiceItemsHasPreview}">
        <TextBlock Grid.Column="0" Text="{Tr 'Total in preview (may change)'}" HorizontalAlignment="Right" Foreground="#FFF59E0B" />
        <TextBlock Grid.Column="1" Text="{Binding CollectionInvoiceItemsPreviewTotalText}" FontWeight="SemiBold" MinWidth="110" TextAlignment="Right" Foreground="#FFF59E0B" />
      </Grid>
      <TextBlock Text="{Tr 'Amounts per item, before the free trial discount, which is applied to the invoice total.'}"
                 FontSize="11"
                 Foreground="{DynamicResource MetaFg}"
                 HorizontalAlignment="Right"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
