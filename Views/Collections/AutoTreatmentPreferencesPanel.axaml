<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LesserDashboardClient.ViewModels.Collections"
             x:DataType="vm:CollectionsViewModel"
             mc:Ignorable="d"
             d:DesignWidth="520"
             d:DesignHeight="160"
             x:Class="LesserDashboardClient.Views.Collections.AutoTreatmentPreferencesPanel">
  <StackPanel Spacing="8"
              IsVisible="{Binding CbEnableAutoTreatment}"
              MaxWidth="520"
              HorizontalAlignment="Stretch">
    <Border Background="{DynamicResource CardBackgroundInactiveBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Tr 'Automatic color correction'}"
                     FontWeight="SemiBold"
                     ToolTip.Tip="{Tr 'Automatic color correction tooltip'}" />
          <TextBlock Text="{Tr 'Automatic color correction hint'}"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1"
                      IsChecked="{Binding CbShowPhotosWithColorCorrectionByDefault, FallbackValue=False}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{Tr 'Automatic color correction tooltip'}" />
      </Grid>
    </Border>

    <Border Background="{DynamicResource CardBackgroundInactiveBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Tr 'Automatic facial enhancement'}"
                     FontWeight="SemiBold"
                     ToolTip.Tip="{Tr 'Automatic facial enhancement tooltip'}" />
          <TextBlock Text="{Tr 'Automatic facial enhancement hint'}"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1"
                      IsChecked="{Binding CbShowPhotosWithFacialEnhancementByDefault, FallbackValue=False}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{Tr 'Automatic facial enhancement tooltip'}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
