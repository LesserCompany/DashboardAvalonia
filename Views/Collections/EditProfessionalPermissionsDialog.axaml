<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LesserDashboardClient.ViewModels.Collections"
        xmlns:local="clr-namespace:LesserDashboardClient.Views.Collections"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia.ProgressRing"
        x:DataType="vm:CollectionsViewModel"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="800"
        x:Class="LesserDashboardClient.Views.Collections.EditProfessionalPermissionsDialog"
        Title="{Tr 'Edit professional'}"
        Width="680"
        Height="820"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="560"
        MinHeight="560">
  <!-- Editar profissional existente: apelido, e-mail, senha e permissões, num gravar só
       (UpdateCompanyProfessional_v2). Aberto pelo botão do card na tela de profissionais. -->
  <Window.Styles>
    <Style Selector="Border.section-card">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.helper">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource MetaFg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
  </Window.Styles>

  <Grid Margin="18" RowDefinitions="Auto,*,Auto,Auto">
    <Border Grid.Row="0" Classes="section-card" CornerRadius="14" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Text="{Tr 'Edit professional'}" FontSize="22" FontWeight="Bold"/>
        <TextBlock FontSize="13" Foreground="{DynamicResource MetaFg}" TextWrapping="Wrap">
          <Run Text="{Tr 'Login:'}"/>
          <Run Text="{Binding EditingProfessional.username}" FontWeight="SemiBold"/>
        </TextBlock>
        <TextBlock Classes="helper" Margin="0,2,0,0" Text="{Tr 'The login cannot be changed: collections keep the login of their separator.'}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel IsEnabled="{Binding !IsSavingProfessionalPermissions}">
        <!-- Dados -->
        <Border Classes="section-card">
          <StackPanel Spacing="10">
            <StackPanel>
              <TextBlock Text="{Tr 'Display name'}" Classes="label"/>
              <TextBox Text="{Binding EditProfessionalSurname}" Watermark="{Tr 'Friendly name shown in the app'}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Tr 'Email'}" Classes="label"/>
              <TextBox Text="{Binding EditProfessionalEmail}" Watermark="email@exemplo.com"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Tr 'New password'}" Classes="label"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <TextBox Grid.Column="0" Text="{Binding EditProfessionalNewPassword}" PasswordChar="●"
                         Watermark="{Tr 'Leave empty to keep the current one'}"/>
                <TextBox Grid.Column="1" Text="{Binding EditProfessionalConfirmPassword}" PasswordChar="●"
                         Watermark="{Tr 'Confirm the new password'}"/>
              </Grid>
              <TextBlock Classes="helper" Text="{Tr 'At least 6 characters. Changing the password signs the professional out and they receive an email warning.'}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Permissões -->
        <Border Classes="section-card">
          <local:ProfessionalPermissionsEditor DataContext="{Binding EditProfessionalPermissions}"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
      <Border IsVisible="{Binding EditProfessionalPermissionsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="#26F44336" BorderBrush="#88F44336" BorderThickness="1" CornerRadius="10" Padding="10">
        <TextBlock Text="{Binding EditProfessionalPermissionsError}" Foreground="#FFD6D6" TextWrapping="Wrap"/>
      </Border>
      <Border IsVisible="{Binding EditProfessionalPermissionsSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="#224CAF50" BorderBrush="#884CAF50" BorderThickness="1" CornerRadius="10" Padding="10">
        <TextBlock Text="{Binding EditProfessionalPermissionsSuccess}" Foreground="#CEF2D2" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <Border Grid.Row="3" Classes="section-card" Padding="10" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="{Tr 'Cancel'}"
                Command="{Binding CancelEditProfessionalPermissionsCommand}"
                IsEnabled="{Binding !IsSavingProfessionalPermissions}"
                CornerRadius="9" Padding="14,8" MinWidth="120"/>
        <Button Command="{Binding SaveProfessionalPermissionsCommand}"
                IsEnabled="{Binding !IsSavingProfessionalPermissions}"
                Background="{DynamicResource Accent}" Foreground="White"
                CornerRadius="9" Padding="14,8" MinWidth="150">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:ProgressRing Width="14" Height="14" BorderThickness="2" IsIndeterminate="True" IsVisible="{Binding IsSavingProfessionalPermissions}"/>
            <TextBlock Text="{Tr 'Save'}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
