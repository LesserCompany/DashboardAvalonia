<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LesserDashboardClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:TabCollections="clr-namespace:LesserDashboardClient.Views.Collections"
        xmlns:TabOptions="clr-namespace:LesserDashboardClient.Views.Options"
        xmlns:TabInvoices="clr-namespace:LesserDashboardClient.Views.Invoices"
        xmlns:TabPersonalize="clr-namespace:LesserDashboardClient.Views.Personalize"
        xmlns:TabSettingsUser="clr-namespace:LesserDashboardClient.Views.SettingsUser"
        xmlns:TabSearchGraduate="clr-namespace:LesserDashboardClient.Views.SearchGraduate"
        xmlns:local="clr-namespace:LesserDashboardClient.Views"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia.ProgressRing"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LesserDashboardClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding TitleApp}"
        ExtendClientAreaToDecorationsHint="false"
        WindowStartupLocation="CenterScreen"
        MinWidth="900"
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Window.Resources>
        <x:Double  x:Key="FontSizeHeaderTabs">14</x:Double>
        <Thickness x:Key="MarginContent">25,4,25,25</Thickness>
    </Window.Resources>

    <Window.Styles>
        <!-- Validade da sessão (topo): usa os brushes de tema do projeto (App.axaml ThemeDictionaries),
             então adapta a dark/light. Normal = texto secundário; perto de expirar/expirada = WarningTextBrush. -->
        <Style Selector="TextBlock.sessionValidity">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.sessionValidity.expiring">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <!-- Ponto de status: verde fixo = sessão saudável (legível em dark e light);
             WarningTextBrush (do tema) quando perto de expirar/expirada. -->
        <Style Selector="Ellipse.sessionDot">
            <Setter Property="Fill" Value="#2ECC71" />
        </Style>
        <Style Selector="Ellipse.sessionDot.expiring">
            <Setter Property="Fill" Value="{DynamicResource WarningTextBrush}" />
        </Style>
    </Window.Styles>
    
    
    <!--TEMPLATE -->
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0">
          <!--SomeOne Content ... -->
        </Grid>
      
        <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto" >
            <!-- Top -->
            <!-- Canto superior direito, tudo numa linha: quem está logado | validade da sessão | mensagens e menu da conta -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,6,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <StackPanel.Styles>
                    <Style Selector="Border.headerDivider">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="18" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Opacity" Value="0.35" />
                    </Style>
                    <Style Selector="TextBlock.accountLabel">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </Style>
                    <Style Selector="TextBlock.accountValue">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Styles>

                <!-- Company: avatar com a inicial, nome e selo "Conta da empresa" -->
                <StackPanel IsVisible="{Binding IsCompanyLogin}"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource SystemControlBackgroundAccentBrush}" />
                        <TextBlock Text="{Binding CompanyInitial}"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding CompanyName}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                            CornerRadius="8"
                            Padding="8,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Tr 'Company account'}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Professional: Usuário | Tipo de conta | Empresa -->
                <StackPanel IsVisible="{Binding IsProfessionalLogin}"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="accountLabel" Text="{Tr 'User:'}" />
                        <TextBlock Classes="accountValue" Text="{Binding LoggedUsername}" />
                    </StackPanel>
                    <Border Classes="headerDivider" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="accountLabel" Text="{Tr 'Account type:'}" />
                        <TextBlock Classes="accountValue" Text="{Binding AccountTypeText}" />
                    </StackPanel>
                    <Border Classes="headerDivider" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="accountLabel" Text="{Tr 'Company:'}" />
                        <TextBlock Classes="accountValue" Text="{Binding CompanyName}" />
                    </StackPanel>
                    <Border Classes="headerDivider" />
                    <!-- Resumo das permissões (funções); o detalhe por área fica no balão -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                Background="Transparent"
                                Cursor="Help"
                                ToolTip.Tip="{Binding PermissionsDetailText}">
                        <TextBlock Classes="accountLabel" Text="{Tr 'Permissions:'}" />
                        <TextBlock Classes="accountValue" Text="{Binding PermissionsSummaryText}" />
                    </StackPanel>
                </StackPanel>

                <Border Classes="headerDivider" />

                <!-- Validade da sessão -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Tr 'Session validity tooltip'}">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Classes="sessionDot"
                             Classes.expiring="{Binding SessionExpiringSoon}" />
                    <TextBlock Text="{Binding SessionValidityText}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Classes="sessionValidity"
                               Classes.expiring="{Binding SessionExpiringSoon}" />
                </StackPanel>

                <!-- Mensagens (abrem dentro da aba Coleções) e menu da conta (sair) -->
                <local:UserMessagesButton IsVisible="{Binding Permissions.CanSeeCollections}" VerticalAlignment="Center" />
                <local:LogoutComponent VerticalAlignment="Center" />
            </StackPanel>

            <!-- Content -->
            <Border Grid.Row="1" Margin="{DynamicResource MarginContent}">
              <Grid RowDefinitions="Auto, *">
                <!-- Professional sem nenhuma aba de conteúdo liberada -->
                <Border Grid.Row="0"
                        IsVisible="{Binding Permissions.HasNoContentTabs}"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource WarningTextBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Tr 'You do not have access to any area yet'}" FontWeight="SemiBold" />
                        <TextBlock Text="{Tr 'Ask the company administrator to grant you permissions in Manage professionals.'}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1" VerticalAlignment="Stretch" SelectedIndex="{Binding SelectedTabIndex}">
                    <!-- Abas escondidas (IsVisible) continuam ocupando o índice: ver MainWindowViewModel.FirstVisibleTabIndex -->
                    <TabItem Header="{Tr 'Collections'}" FontSize="{DynamicResource FontSizeHeaderTabs}" IsVisible="{Binding Permissions.CanSeeCollections}">
                      <TabCollections:CollectionsControl />
                    </TabItem>

                    <TabItem Header="{Tr 'Diagramar'}" FontSize="{DynamicResource FontSizeHeaderTabs}" IsVisible="{Binding Permissions.CanSeeDiagrammer}">
                      <TabItem.ContentTemplate>
                        <DataTemplate>
                          <local:DiagramationControl x:CompileBindings="True" x:Name="DiagramationTab" IsVisible="True" />
                        </DataTemplate>
                      </TabItem.ContentTemplate>
                    </TabItem>
                    
                    <TabItem Header="{Tr 'User per CPF'}" FontSize="{DynamicResource FontSizeHeaderTabs}" IsVisible="{Binding Permissions.CanSeeSearchGraduate}">
                      <TabItem.ContentTemplate>
                        <DataTemplate>
                          <TabSearchGraduate:SearchGraduateControl x:CompileBindings="True" x:Name="SearchGraduateTab" IsVisible="True" />
                        </DataTemplate>
                      </TabItem.ContentTemplate>
                    </TabItem>
                    
                    <TabItem Header="{Tr 'Invoices'}" FontSize="{DynamicResource FontSizeHeaderTabs}" IsVisible="{Binding Permissions.CanSeeInvoices}">
                      <TabItem.ContentTemplate>
                        <DataTemplate>
                          <TabInvoices:InvoicesControl x:CompileBindings="True" x:Name="InvoicesTab" IsVisible="True" />
                        </DataTemplate>
                      </TabItem.ContentTemplate>
                    </TabItem>
                    
                    <TabItem Header="{Tr 'Personalize'}" FontSize="{DynamicResource FontSizeHeaderTabs}" IsVisible="{Binding Permissions.CanSeeCompanyConfig}">
                      <TabItem.ContentTemplate>
                        <DataTemplate>
                          <TabPersonalize:PersonalizeControl x:CompileBindings="True" x:Name="PersonalizeTab" IsVisible="True" />
                        </DataTemplate>
                      </TabItem.ContentTemplate>
                    </TabItem>
                    
                    <TabItem Header="{Tr 'UserSettings'}" FontSize="{DynamicResource FontSizeHeaderTabs}" IsVisible="{Binding Permissions.CanSeeCompanyConfig}">
                      <TabItem.ContentTemplate>
                        <DataTemplate>
                          <TabSettingsUser:SettingsUserControl x:CompileBindings="True" x:Name="SettingsUserTab" IsVisible="True" />
                        </DataTemplate>
                      </TabItem.ContentTemplate>
                    </TabItem>
                    
                    <TabItem Header="{Tr 'Options'}" FontSize="{DynamicResource FontSizeHeaderTabs}">
                      <TabOptions:OptionsControl />
                    </TabItem>
                </TabControl>
              </Grid>
            </Border>

            <!-- Footer -->
            <Grid  Grid.Row="2" RowDefinitions="Auto, Auto" Background="{DynamicResource SystemControlBackgroundListMediumBrush}">
              <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                <!-- Coluna 0: Versão e Badge de Ambiente -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4" Orientation="Horizontal" Spacing="8">
                  <local:AppVersionControl  />
                  <local:EnvironmentBadgeControl />
                </StackPanel>
                  
                <!-- Coluna 1: CarregandoEndpoints (Centralizado) -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           Spacing="4" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                  <StackPanel IsVisible="{Binding IsLoadingEndpointsInfo}" 
                             Orientation="Horizontal" 
                             Spacing="4" 
                             VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" 
                                    BorderThickness="2" 
                                    Width="12" 
                                    Height="12" 
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Carregando informações dos endpoints..." 
                              FontSize="12" 
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
                
                <!-- Coluna 2: Está com problemas? | Botão Suporte (Direita) -->
                <StackPanel Grid.Column="2" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Right"
                           Margin="4"
                           Orientation="Horizontal"
                           Spacing="4">
                  <TextBlock FontSize="11" 
                            Text="{Tr 'Having problems?'}" 
                            Margin="0 0 4 0" 
                            FontWeight="SemiBold" 
                            VerticalAlignment="Center" />
                  <Button Height="25" 
                         HorizontalAlignment="Center" 
                         Background="{DynamicResource SystemChromeBlackMediumLowColor}" 
                         Command="{Binding OpenWhatsAppSuportCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Tr 'Support'}" 
                                FontSize="11" 
                                Foreground="White" 
                                VerticalAlignment="Center" 
                                Margin="2 0" />
                      <Grid Width="20" Height="20">
                        <Ellipse Fill="{DynamicResource SystemControlBackgroundAccentBrush}" />
                        <Svg Path="/Assets/icons/whatsapp-white.svg" 
                             Width="11" 
                             Height="11" 
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>  
              <local:UpdateAppProgressBarControl Grid.Row="1" IsVisible="{Binding IsUpdateSomeOneComponent}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
